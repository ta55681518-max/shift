    "test:config": "node --test tests/config.test.mjs",
    "test:data": "node --test tests/core-sales.test.mjs tests/data-costs.test.mjs",
    "test:backup": "node --test tests/backup-roundtrip.test.mjs",
    "risk": "node automation/classify-risk.mjs",
    "serve": "node automation/serve.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
